{
  "name": "tessela-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Electron editor for Tessela bundles. It uses the tessela command line tools behind the scenes.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "npm run build:app && npm run build:renderer",
    "build:app": "esbuild main=src/main/main.ts preload=src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist --out-extension:.js=.cjs",
    "build:renderer": "vite build",
    "start": "npm run build && electron . --no-sandbox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && node e2e/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2"
  }
}
